{
  "name": "hack-apertus-review-triage",
  "version": "0.1.0",
  "description": "Multilingual customer-review triage agent for Hack Apertus Track 2B. The agent drafts; only the owner publishes.",
  "private": true,
  "license": "Apache-2.0",
  "author": "Chetan Gupta",
  "engines": {
    "node": ">=24"
  },
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "test": "jest",
    "lint": "eslint .",
    "eval": "node scripts/eval.js",
    "report:fill": "node scripts/report-fill.js",
    "report:check": "node scripts/report-fill.js --check",
    "report:pdf": "node scripts/export-report.js"
  },
  "dependencies": {
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "marked": "15.0.12"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/tests/**/*.test.js"
    ]
  }
}
